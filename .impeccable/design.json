  "narrative": {
    "northStar": "The Plate Section",
    "overview": "Hexnex presents its work the way a design annual presents its plates: each solution is a printed plate on a near-white uncoated sheet, fixed in place by registration crosshairs, captioned with a mono plate credit, and countersigned by one rotating circular seal that carries the logo mark. The page reads as a printed object, not as an app shell. Navy ink does the talking; the brand blues and cyan appear as registration color, never as decoration.\n\nDensity is calm and editorial. A 12-column sheet holds large regular-weight grotesque headlines on one side and a single plate on the other, with generous section air between spreads. Every structural line is a 1px hairline. Depth comes from paper and hairlines, not from lifted cards. The site's demonstration plates (a WhatsApp conversation, a leads register) are authored reproductions labeled as examples; where a plate reproduces a third-party product, that product keeps its own official colors and shapes inside the plate frame.\n\nThe build rejects the agency default of headline plus phone mockup plus a row of rounded icon cards; that is the confirmed anti-reference from the direction contract.",
    "keyCharacteristics": [
      "Near-white sheet (paper) with a cool drift at the top-left and a warm drift lower right, never a flat white page.",
      "Navy ink for all text and primary controls; pure black is never used.",
      "1px hairlines for every divider, frame and table rule; dashed hairlines only between credit columns.",
      "CSS registration crosshairs at the four corners of every plate.",
      "One grotesque (Hanken Grotesk) for display and body; 11px mono caps (JetBrains Mono) for registration labels, plate credits, nav tokens, buttons, table heads and state chips.",
      "Square Hexnex controls; circles are reserved for the logo mark, the seal, avatars and the floating WhatsApp button.",
      "A single rotating seal per page, in cyan wash with a cyan rule."
    ],
    "rules": [
      {
        "name": "The Never-Black Rule",
        "body": "Text and dark surfaces are Annual Navy. Pure black does not appear anywhere in the Hexnex layer.",
        "section": "colors"
      },
      {
        "name": "The Quarantined Green Rule",
        "body": "WhatsApp green and its companions appear only on WhatsApp's own mark, WhatsApp buttons and the WhatsApp plate. They never become a Hexnex accent, divider or highlight.",
        "section": "colors"
      },
      {
        "name": "The Registration Color Rule",
        "body": "Blue, deep blue and cyan mark registration: seal, focus, numerals, glyph strokes, state chips. They do not fill sections or large surfaces.",
        "section": "colors"
      },
      {
        "name": "The One Grotesque Rule",
        "body": "Display and body are the same family at weight 400. Hierarchy comes from size and tracking, not from bold.",
        "section": "typography"
      },
      {
        "name": "The Registration Mono Rule",
        "body": "Mono is always 11 to 13px, uppercase and tracked. It labels and credits; it never sets a headline or a paragraph.",
        "section": "typography"
      },
      {
        "name": "The Mounted Plate Rule",
        "body": "Plates sit on the sheet with a hairline ring and an offset outline. Never give a plate a drop shadow or a hard offset shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** set every text and dark surface in Annual Navy (#0e2358).",
      "**Do** frame every plate with a 1px hairline ring, an offset soft outline (10px) and four registration crosshairs, and caption it with a mono plate credit.",
      "**Do** label authored demonstration plates as examples in their credit until the owner supplies real screenshots.",
      "**Do** keep Hexnex controls square with mono caps labels, 44 to 56px tall.",
      "**Do** use the owner's official logo files as supplied and present the mark in a circle.",
      "**Do** reproduce third-party products (WhatsApp) in their official colors and shapes, inside the plate frame.",
      "**Do** keep headlines at weight 400 with negative tracking and let size carry hierarchy."
    ],
    "donts": [
      "**Don't** use pure black, or any accent other than the logo's blues and cyan, in the Hexnex layer.",
      "**Don't** let WhatsApp green leave WhatsApp's mark, buttons and plate.",
      "**Don't** give plates drop shadows or hard offset shadows.",
      "**Don't** round Hexnex buttons, chips or plates; circles are only for the logo mark, seal, avatar and floating button.",
      "**Don't** set headlines or paragraphs in mono, or place mono labels above headlines as kickers.",
      "**Don't** fall back to the headline + phone mockup + row of rounded icon cards composition.",
      "**Don't** add a second seal or a second display family."
    ]
  }
